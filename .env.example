# Copier en .env, remplir, puis `pnpm env:sync` (copie dans apps/client, apps/courier, apps/web).
# Ne jamais commiter .env.

# --- Supabase ---
# En local (`supabase start`) : URL http://127.0.0.1:54321 et clé anon affichées par la commande.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Côté serveur uniquement (Edge Functions, scripts) — jamais dans une app
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps (voir docs/GOOGLE_MAPS.md) ---
# Clé Android : restreinte au package + SHA-1 du certificat EAS
GOOGLE_MAPS_ANDROID_KEY=
# Clé web : restreinte à notre domaine, Maps JavaScript uniquement
NEXT_PUBLIC_GOOGLE_MAPS_WEB_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
# Clé serveur : Places, Geocoding, Routes. À mettre en secret Supabase (supabase secrets set)
GOOGLE_MAPS_SERVER_KEY=

# --- Notifications ---
# Fichier google-services.json du projet Firebase (chemin relatif à apps/client ou apps/courier), pour FCM
GOOGLE_SERVICES_JSON=./google-services.json
# Web Push (PWA) — générer avec `npx web-push generate-vapid-keys`
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
EXPO_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# Secret partagé entre la base (table private_settings) et l'Edge Function notify
NOTIFY_SECRET=

# --- Messages (code de connexion + code de livraison au destinataire) ---
# Ordre : WhatsApp d'abord, SMS en secours. Valeurs à mettre en secrets Supabase (supabase secrets set …).
# SMS_PROVIDER : log (développement, rien n'est envoyé) | twilio | africastalking (SMS seul)
SMS_PROVIDER=log
SMS_SENDER_ID=Koursa
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro WhatsApp Business validé par Meta (format +228…)
TWILIO_WHATSAPP_FROM=
# Modèle WhatsApp « code de livraison » approuvé (HX…) : {{1}} = code, {{2}} = lien de suivi
TWILIO_WHATSAPP_CONTENT_SID=
# Expéditeur SMS : numéro Twilio (+…) ou Messaging Service (MG…)
TWILIO_SMS_FROM=
# Africa's Talking uniquement : SMS_API_KEY=USERNAME:API_KEY
SMS_API_KEY=
# Code de CONNEXION (OTP) : se configure dans Supabase → Authentication → Providers → Phone
# (fournisseur Twilio + « Twilio WhatsApp »). config.toml local : variables TWILIO_MESSAGE_SERVICE_SID.
TWILIO_MESSAGE_SERVICE_SID=

# --- Expo / EAS ---
EAS_PROJECT_ID_CLIENT=
EAS_PROJECT_ID_COURIER=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://
EXPO_PUBLIC_SITE_URL=https://
SITE_URL=https://
DOWNLOADS_BUCKET=downloads

# --- Suivi des erreurs ---
SENTRY_DSN=
